# Absoluten Pfad zu deinem 3D-Dateien-Ordner eintragen (Windows: Forward-Slashes verwenden!)
# Beispiel: DATA_ROOT=D:/Druckdaten
DATA_ROOT=./beispiel-daten

# Port, unter dem die Weboberflaeche im Browser erreichbar ist
APP_PORT=3000

# Ab welcher Dateigroesse (in MB) wird auf ein server-gerendertes Thumbnail
# verzichtet? Software-Rendering ohne Grafikkarte (SwiftShader) ist bei sehr
# grossen/komplexen Modellen zu langsam und laeuft sonst zuverlaessig in den
# Timeout. Betroffene Dateien bekommen den Platzhalter "Keine Vorschau
# verfuegbar" statt ein echtes Thumbnail. Standard 40 MB, aus echten
# Testdaten abgeleitet (19 MB rendert noch, 47+ MB scheitert zuverlaessig
# auch mit hohem Timeout) - bei Bedarf anpassen, z.B. wenn du eine schnellere
# Maschine hast oder es trotzdem versuchen willst.
# THUMB_MAX_SIZE_MB=40

# EXPERIMENTELL: echte GPU-Beschleunigung fuer Thumbnails statt Software-
# Rendering (SwiftShader). Nur relevant mit NVIDIA-GPU und funktionierendem
# GPU-Zugriff in Docker Desktop (WSL2). Erfordert zusaetzlich den Start mit
# der docker-compose.gpu.yml-Override-Datei (siehe README/dortige Kommentare).
# GPU_ACCEL=true
